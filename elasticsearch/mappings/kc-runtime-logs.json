{
  "settings": {"number_of_shards": 1, "number_of_replicas": 0, "index.default_pipeline": "kc-runtime-logs-normalize"},
  "mappings": {
    "dynamic": "false",
    "properties": {
      "@timestamp": {"type": "date"},
      "log_id": {"type": "keyword"},
      "message": {"type": "text"},
      "log": {"properties": {"level": {"type": "keyword"}, "logger": {"type": "keyword"}}},
      "event": {"properties": {"kind": {"type": "keyword"}, "action": {"type": "keyword"}, "outcome": {"type": "keyword"}, "dataset": {"type": "keyword"}}},
      "http": {"properties": {
        "request": {"properties": {"method": {"type": "keyword"}}},
        "response": {"properties": {"status_code": {"type": "integer"}, "bytes": {"type": "long"}}}
      }},
      "url": {"properties": {
        "original": {"type": "keyword", "ignore_above": 4096},
        "path": {"type": "keyword", "ignore_above": 2048},
        "query": {"type": "keyword", "ignore_above": 4096},
        "query_param_names": {"type": "keyword"}
      }},
      "client_id": {"type": "keyword"},
      "client_identified": {"type": "boolean"},
      "client_id_source": {"type": "keyword"},
      "client": {"properties": {"id": {"type": "keyword"}}},
      "source": {"properties": {"ip": {"type": "ip"}}},
      "user_agent": {"properties": {"original": {"type": "keyword", "ignore_above": 1024}}},
      "keycloak": {"properties": {
        "realm": {"type": "keyword"},
        "user_id": {"type": "keyword"},
        "error": {"type": "keyword"},
        "instance": {"type": "keyword"},
        "version": {"type": "keyword"}
      }},
      "labels": {"properties": {"origin": {"type": "keyword"}, "source_file": {"type": "keyword"}}}
    }
  }
}
