# --- Keycloak versions under test ---
KC_SOURCE_VERSION=26.5.0
KC_TARGET_VERSION=26.6.3
# Used only by the 'legacy' profile (before/after of the 26.0.0 and 26.4.3 changes)
KC_LEGACY_VERSION=25.0.6
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# --- Elastic stack ---
ELASTIC_VERSION=8.15.3
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- Backend ---
# hash = deterministic local embeddings; sentence-transformers = local model (install it in the image)
EMBEDDING_BACKEND=hash
# none = no LLM (rules from the curated manifest); ollama = local model, no API cost
LLM_PROVIDER=none
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Ingest everything and run the scenario assessments at startup
AUTO_BOOTSTRAP=true
# Optional: download the official upgrading guide instead of the local excerpt
BC_SOURCE_URL=

# --- Postgres ---
POSTGRES_PASSWORD=keycloak
