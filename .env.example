# --- Keycloak versions under test ---
KC_SOURCE_VERSION=26.5.0
KC_TARGET_VERSION=26.6.3
# Used only by the 'legacy' profile (before/after of the 26.0.0 and 26.4.3 changes)
KC_LEGACY_VERSION=25.0.6
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# --- Elastic stack ---
ELASTIC_VERSION=8.15.3
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- Backend ---
# hash = deterministic local embeddings; sentence-transformers = local model (install it in the image)
EMBEDDING_BACKEND=hash
# LLM used ONLY by the manual sync job (bc-sync) to map guide entries onto the detector registry.
# none | openai | ollama. Detection never calls the LLM.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 0 = deterministic; leave empty for models that reject the temperature parameter
LLM_TEMPERATURE=0
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Ingest everything and run the scenario assessments at startup
AUTO_BOOTSTRAP=true
# Data sources readable at detection time; checks on other sources (server_config, server_info,
# database, custom_extensions, ...) are listed as "not executed"
AVAILABLE_DATA_SOURCES=realm_export,access_log,event_log,server_log

# --- Breaking changes sync job ---
BC_SOURCE_URL=https://www.keycloak.org/docs/latest/upgrading/index.html
# Entries sent to the LLM: versions >= BC_MIN_VERSION and these categories of the guide
BC_MIN_VERSION=22.0.0
BC_LLM_CATEGORIES=breaking,deprecated,removed,end-of-life,uncategorized

# --- Postgres ---
POSTGRES_PASSWORD=keycloak
